{
  "name": "tvb-electron",
  "version": "1.0.0",
  "description": "TVB - Transcode Video Batch (Electron GUI + Python Backend)",
  "main": "electron/main.js",
  "scripts": {
    "start": "unset ELECTRON_RUN_AS_NODE && /Users/stephan/.local/electron/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron .",
    "dev:react": "vite",
    "build:react": "vite build",
    "build:python": "cd python && ../.venv/bin/pyinstaller --onefile --name tvb tvb.py --paths . --add-binary ../bin/HandBrakeCLI:. --add-binary ../bin/libmediainfo.dylib:. --add-binary ../bin/ffprobe:. --hidden-import pymediainfo --hidden-import configparser --hidden-import transcode.analyzer --hidden-import transcode.generator --hidden-import features.atmos --hidden-import features.statistics --hidden-import config.config_loader --distpath dist --workpath build --specpath .",
    "build": "npm run build:react && npm run build:python",
    "dist": "npm run build && npx electron-builder --mac",
    "dist:win": "npm run build && npx electron-builder --win",
    "dist:linux": "npm run build && npx electron-builder --linux"
  },
  "build": {
    "appId": "com.tvb.electron",
    "productName": "TVB",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "python/**/*",
      "!python/build/**/*",
      "!python/__pycache__/**/*",
      "!python/**/*.pyc",
      "!python/**/__pycache__",
      "!python/tvb.spec"
    ],
"extraResources": [
      {
        "from": "python/dist",
        "to": "app/python/dist",
        "filter": ["tvb"]
      },
      {
        "from": "python",
        "to": "app/python",
        "filter": ["tvb-config.ini"]
      }
    ],
"mac": {
      "category": "public.app-category.video",
      "target": ["dmg", "zip"],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.2.0",
    "electron-builder": "^26.0.0",
    "vite": "^8.0.13"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
