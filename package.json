{
  "name": "tvb",
  "version": "1.0.0",
  "description": "TVB - Transcode Video Batch (GUI and CLI)",
  "author": "breacasu <breacasu@posteo.de>",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "./start.sh",
    "start:win": "start.bat",
    "dev:react": "vite",
    "verify:tools": "python scripts/verify_tools.py",
    "stage:tools": "python scripts/stage_tools.py",
    "build:react": "vite build",
    "build:python": "python scripts/build_python.py",
    "build:python:win": "python scripts/build_python.py",
    "build": "npm run build:react && npm run build:python",
    "build:win": "npm run build:react && npm run build:python:win",
    "dist": "npm run build && npx electron-builder --mac",
    "dist:win": "npm run build:win && npx electron-builder --win",
    "dist:linux": "npm run build && npx electron-builder --linux"
  },
  "build": {
    "appId": "com.breacasu.tvb",
    "electronVersion": "42.2.0",
    "productName": "tvb",
    "executableName": "tvb-gui",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "!python/**/*",
      "!python/build/**/*",
      "!python/__pycache__/**/*",
      "!python/**/*.pyc",
      "!python/**/__pycache__",
      "!python/tvb.spec"
    ],
    "extraResources": [
      {
        "from": "python/dist",
        "to": "app/python/dist",
        "filter": [
          "tvb*"
        ]
      },
      {
        "from": "python",
        "to": "app/python",
        "filter": [
          "tvb-config.ini"
        ]
      }
    ],
    "afterPack": "build/afterPack.js",
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "electron-builder": "^26.0.0",
    "vite": "^8.0.13"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
