# TVB - Transcode Video Batch Configuration

[tvshow]
# Cross-platform H.265 encoding for TV shows
parameter = --mode hevc --quality 24 --add-audio all --add-subtitle all

[movie]
# H.265 encoding for movies with German and English audio
parameter = --mode hevc --quality 24 --add-audio ger --add-audio eng --add-subtitle all

[custom]
# H.265 encoding with all available audio and subtitle tracks
parameter = --mode hevc --quality 24 --add-audio all --add-subtitle all

[preview]
# Preview clip length
parameter = --stop-at duration:30

[default]
# Output directory; adjust this value or pass -o/--output
outputdir = './output'

# File handling
preserve_file_date = yes

# Dolby Atmos preservation
preserve_atmos_audio = yes
